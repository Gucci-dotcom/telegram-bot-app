# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Канал: @username или числовой id (-100...). Бот должен быть админом канала с правом публикации.
CHANNEL_ID=@my_channel
# Telegram user id администраторов через запятую (узнать свой id: @userinfobot)
ADMIN_IDS=123456789
# Пароль для входа в веб-интерфейс из обычного браузера (вне Telegram)
ADMIN_TOKEN=change-me
# Публичный HTTPS-адрес веб-интерфейса — станет кнопкой Mini App в боте
WEBAPP_URL=https://example.com
# Часовой пояс и слоты автопубликации очереди
TIMEZONE=Europe/Moscow
SCHEDULE_SLOTS=09:00,13:00,19:00
# Хранилище
DB_PATH=data/posts.db
MEDIA_DIR=data/media
HOST=0.0.0.0
PORT=8000
